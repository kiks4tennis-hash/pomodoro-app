{
  "expo": {
    "name": "Focus Timer",
    "slug": "pomodoro-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.Kazumax71.pomodoro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.Kazumax71.pomodoro",
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F3ED"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C76D4E",
          "sounds": ["./assets/sounds/gentle-bell.wav", "./assets/sounds/soft-chime.wav", "./assets/sounds/warm-tone.wav"]
        }
      ],
      "expo-widgets",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3ED",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "728fa9fd-30bb-4358-ae7a-ca767751247e"
      }
    }
  }
}
